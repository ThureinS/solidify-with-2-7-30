generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ReviewResult {
  REVIEWED
  SKIPPED
}

enum ItemMode {
  FIXED
  ADAPTIVE
}

// The judgment given at each Adaptive Mode review (see CONTEXT.md). Fixed
// Mode reviews never carry one.
enum Grade {
  AGAIN
  HARD
  GOOD
  EASY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  isSuspended  Boolean  @default(false)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  items Item[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// Bonus feature, not in the graded spec (see submission-requirements.md and
// developer-handover.md §12b) -- backs POST /auth/refresh. One row per
// refresh token ever issued; rotation marks the old row revoked instead of
// deleting it, so a reused (already-rotated) token can still be recognised
// as stolen and used to kill its whole family.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Item {
  id             String    @id @default(uuid())
  userId         String
  text           String
  dateAdded      DateTime  @db.Date
  nextReviewDate DateTime  @db.Date
  mode           ItemMode  @default(FIXED)
  stage          Int       @default(0)
  isComplete     Boolean   @default(false)
  // Fixed Mode only: the configurable longest ladder rung (default 30, the
  // original graded-spec value). Unused while mode is ADAPTIVE.
  finalIntervalDays Int    @default(30)
  // Adaptive Mode only (FSRS state, see CONTEXT.md); null until the item's
  // first Adaptive review.
  difficulty     Float?
  stability      Float?
  lastReviewDate DateTime? @db.Date
  deletedAt      DateTime? @db.Date

  user    User     @relation(fields: [userId], references: [id])
  reviews Review[]

  @@index([userId, nextReviewDate])
  @@map("items")
}

model Review {
  id     String       @id @default(uuid())
  itemId String
  date   DateTime     @db.Date
  result ReviewResult
  // Set only for Adaptive Mode REVIEWED rows; null for Fixed Mode and for
  // every SKIPPED row regardless of mode.
  grade  Grade?

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId, date])
  @@map("reviews")
}
