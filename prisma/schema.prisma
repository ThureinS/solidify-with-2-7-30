generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ReviewResult {
  REVIEWED
  SKIPPED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  isSuspended  Boolean  @default(false)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  items Item[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// Bonus feature, not in the graded spec (see submission-requirements.md and
// developer-handover.md §12b) -- backs POST /auth/refresh. One row per
// refresh token ever issued; rotation marks the old row revoked instead of
// deleting it, so a reused (already-rotated) token can still be recognised
// as stolen and used to kill its whole family.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Item {
  id             String    @id @default(uuid())
  userId         String
  text           String
  dateAdded      DateTime  @db.Date
  nextReviewDate DateTime  @db.Date
  stage          Int       @default(0)
  isComplete     Boolean   @default(false)
  deletedAt      DateTime? @db.Date

  user    User     @relation(fields: [userId], references: [id])
  reviews Review[]

  @@index([userId, nextReviewDate])
  @@map("items")
}

model Review {
  id     String       @id @default(uuid())
  itemId String
  date   DateTime     @db.Date
  result ReviewResult

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId, date])
  @@map("reviews")
}
